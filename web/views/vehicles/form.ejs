<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container" style="max-width: 800px;">
  <%- include('../partials/alerts') %>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title"><%= vehicle ? 'Cập nhật Phương tiện' : 'Thêm Phương tiện mới vào Đội xe' %></h2>
      <a href="/vehicles" class="btn btn-outline btn-sm">&larr; Hủy</a>
    </div>

    <form action="/vehicles/create?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="plate_number">Biển số xe *</label>
          <input type="text" id="plate_number" name="plate_number" class="form-control" placeholder="30A-123.45" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="vehicle_type_id">Phân loại xe *</label>
          <select id="vehicle_type_id" name="vehicle_type_id" class="form-control" required>
            <% types.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="make">Hãng sản xuất *</label>
          <input type="text" id="make" name="make" class="form-control" placeholder="Toyota" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="model">Mẫu xe *</label>
          <input type="text" id="model" name="model" class="form-control" placeholder="Vios 1.5G" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="year">Năm sản xuất * (&ge; 1990)</label>
          <input type="number" id="year" name="year" class="form-control" min="1990" max="2030" value="2023" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="vin">Số khung (VIN)</label>
          <input type="text" id="vin" name="vin" class="form-control" placeholder="RL4BT9134NL102931">
        </div>

        <div class="form-group">
          <label class="form-label" for="fuel_type">Nhiên liệu *</label>
          <select id="fuel_type" name="fuel_type" class="form-control" required>
            <option value="gasoline">Xăng (Gasoline)</option>
            <option value="diesel">Dầu (Diesel)</option>
            <option value="hybrid">Hybrid</option>
            <option value="electric">Điện (Electric)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="seats">Số chỗ ngồi * (&gt; 0)</label>
          <input type="number" id="seats" name="seats" class="form-control" min="1" max="100" value="5" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="odometer_km">Công tơ mét (km) *</label>
          <input type="number" id="odometer_km" name="odometer_km" class="form-control" min="0" value="1000" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="status">Trạng thái *</label>
          <select id="status" name="status" class="form-control" required>
            <option value="available">Sẵn sàng (Available)</option>
            <option value="maintenance">Bảo dưỡng (Maintenance)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="registration_expiry">Hạn đăng kiểm *</label>
          <input type="date" id="registration_expiry" name="registration_expiry" class="form-control" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="insurance_expiry">Hạn bảo hiểm *</label>
          <input type="date" id="insurance_expiry" name="insurance_expiry" class="form-control" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="next_service_km">Bảo dưỡng kế tiếp (km) *</label>
          <input type="number" id="next_service_km" name="next_service_km" class="form-control" min="0" value="10000" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="image">Tải lên ảnh xe (JPG, PNG, WEBP &le; 2MB)</label>
          <input type="file" id="image" name="image" class="form-control" accept="image/png, image/jpeg, image/webp">
        </div>
      </div>

      <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end; gap: 1rem;">
        <a href="/vehicles" class="btn btn-outline">Hủy</a>
        <button type="submit" class="btn btn-primary">Lưu phương tiện</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
