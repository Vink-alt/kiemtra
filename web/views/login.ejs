<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container" style="max-width: 440px; margin-top: 4rem;">
  <%- include('partials/alerts') %>
  
  <div class="card" style="padding: 2rem;">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--dark);">Đăng nhập Hệ thống</h2>
      <p style="font-size: 0.875rem; color: var(--muted); margin-top: 0.25rem;">Hệ thống Quản lý Đội xe chuyên nghiệp</p>
    </div>

    <form action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="form-group">
        <label class="form-label" for="username">Tên đăng nhập</label>
        <input type="text" id="username" name="username" class="form-control" placeholder="admin, dieuphoi01, taixe01..." required autofocus>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label class="form-label" for="password">Mật khẩu</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">Đăng nhập ngay</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
