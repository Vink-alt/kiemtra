# ==============================================================================
# FLEET MANAGEMENT SYSTEM - CONFIGURATION TEMPLATE
# ==============================================================================
NODE_ENV=production
PORT=3000
SESSION_SECRET=example_session_secret_min_20_chars_fleet_devops

# Database (PostgreSQL)
POSTGRES_DB=fleetdb
POSTGRES_USER=fleet_app
POSTGRES_PASSWORD=example_postgres_strong_password_fleet_2026
DATABASE_URL=postgresql://fleet_app:example_postgres_strong_password_fleet_2026@db:5432/fleetdb

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@fleet.local
PGADMIN_DEFAULT_PASSWORD=example_pgadmin_strong_password_2026

# Seed passwords (for testing reference)
SEED_ADMIN_PASSWORD=example_admin_pass
SEED_DISP_PASSWORD=example_disp_pass
SEED_DRIVER_PASSWORD=example_driver_pass
